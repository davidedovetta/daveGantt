generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique
  name         String
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions      Session[]
  memberships   WorkspaceMember[]
  assignedTasks Task[]            @relation("TaskAssignee")
  createdTasks  Task[]            @relation("TaskCreator")
}

/// `id` is the SHA-256 hash of the session token; the raw token only lives in the cookie.
model Session {
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  projects  Project[]
}

model WorkspaceMember {
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role
  createdAt   DateTime  @default(now())

  @@id([workspaceId, userId])
  @@index([userId])
}

enum TaskType {
  TASK
  MILESTONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]

  @@index([workspaceId])
}

/// A task with children is a summary: its dates and progress are rolled up from them.
/// `sortKey` is a fractional index among siblings; compare it byte-wise in JS, not with
/// ORDER BY (the database collation does not sort it correctly).
model Task {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @db.Uuid
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?    @db.Uuid
  parent      Task?      @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]     @relation("TaskTree")
  type        TaskType   @default(TASK)
  name        String
  description String     @default("")
  startDate   DateTime   @db.Date
  endDate     DateTime   @db.Date
  progress    Int        @default(0)
  status      TaskStatus @default(TODO)
  color       String?
  assigneeId  String?    @db.Uuid
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sortKey     String
  version     Int        @default(1)
  createdById String?    @db.Uuid
  createdBy   User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId])
  @@index([parentId])
}
